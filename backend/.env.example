# automation-frontend / backend
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so never
# put a real secret here.
#
# Two groups fail hard rather than degrading:
#   - the upstream service URLs + API_SERVICE_KEY are validated in
#     src/utils/axios.ts at module load, so the process will not boot without them
#   - NODE_ENV is required by @ondc/automation-logger, same story
# Everything else either has a default or only disables the feature that uses it.

# ── Core ─────────────────────────────────────────────────────────────────────
# REQUIRED. "development" relaxes CORS to allow any origin (see config/corsOptions.ts).
NODE_ENV=development
# Shown in logs and traces.
SERVICE_NAME=automation-ui-backend-local
PORT=4000

# ── Upstream services ────────────────────────────────────────────────────────
# ALL REQUIRED — src/utils/axios.ts throws at import time if any is missing.
API_SERVICE=http://localhost:5002
DB_SERVICE=http://localhost:5001
CONFIG_SERVICE=http://localhost:5003
MOCK_SERVICE=http://localhost:5004
REPORTING_SERVICE=http://localhost:5005

# Sent as x-api-key to the services above. REQUIRED.
API_SERVICE_KEY=local-dev-key

# automation-db's own key. Must equal that service's API_SERVICE_KEY.
# Used by src/services/dbService.ts and by the business dashboard proxy.
DB_SERVICE_API_KEY=local-dev-key

# ── Business dashboard (/dashboard) ──────────────────────────────────────────
# Shared password typed on the dashboard sign-in card.
DASHBOARD_PASSWORD=local

# Signs the dashboard session cookie. MINIMUM 32 CHARACTERS.
# Deliberately NOT SESSION_SECRET: that one carries workbench OAuth identity,
# and a shared key would let either scheme mint the other's sessions.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DASHBOARD_SESSION_SECRET=change-me-to-at-least-32-random-characters

# Optional. If DASHBOARD_PASSWORD or DASHBOARD_SESSION_SECRET is missing or the
# secret is too short, every /dashboard route answers 503 and the rest of the
# backend is unaffected — the dashboard is disabled, not the workbench.
# DASHBOARD_COOKIE_NAME=wbd_session
# DASHBOARD_SESSION_TTL_MS=43200000

# Only the exact string "true" enables secure cookies. Set it wherever this is
# served over HTTPS, or the dashboard session will not stick.
SECURE_COOKIES=false

# ── Redis ────────────────────────────────────────────────────────────────────
# Backs the express-session store via @ondc/ondc-automation-cache-lib.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_RETRY_DELAY=

# Signs the express-session cookie (workbench OAuth identity).
SESSION_SECRET=change-me

# ── GitHub OAuth + registry ──────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
IN_HOUSE_REGISTRY=
# Where to send the browser after the OAuth callback, and this service's own
# public URL (used to build the callback).
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# ── Admin gate ───────────────────────────────────────────────────────────────
# Shared credentials for /db/admin/auth (db-back-office, framework-health).
# Unrelated to DASHBOARD_PASSWORD above.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ── Observability ────────────────────────────────────────────────────────────
# Both optional: unset means the logger skips shipping and OTel has no collector.
# TRACE_URL=
# LOKI_HOST=
# LOG_LEVEL=info

# ── S3 (image upload) ────────────────────────────────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# S3_BUCKET_NAME=
# S3_FOLDER=

# ── Other integrations ───────────────────────────────────────────────────────
# DEVELOPER_GUIDE_SERVICE=
# FINVU_SERVICE_URL=
# NOMINATIM_BASE_URL=
# OSRM_BASE_URL=
