# automation-frontend / frontend
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
# WARNING: Vite inlines every VITE_* value into the client bundle at build time.
# Nothing here is a secret, and nothing secret may be added here — see the note
# on VITE_DB_SERVICE_API_KEY below.

# ── Backends ─────────────────────────────────────────────────────────────────
# Main backend. The business dashboard rides on this too, calling
# `${VITE_BACKEND_URL}/dashboard` — it needs no variable of its own, which is
# how automation-db's key stays server-side.
VITE_BACKEND_URL=http://localhost:4000

# Developer Guide API (auth exchange, notes, comments).
VITE_DEVELOPER_GUIDE_BACKEND_URL=http://localhost:4000

# API service base. Read with `new URL(...)` in a few places, so an invalid
# value throws at runtime rather than degrading.
VITE_BASE_URL=http://localhost:3001/api-service

# ── Feature flags ────────────────────────────────────────────────────────────
# "development" | "pre-prod" | "production" — see src/types/environment.ts.
# "development" shows the dev banner and widens the header offset.
VITE_ENVIRONMENT=development

# Developer Guide routes and nav. Defaults to ENABLED; only the exact string
# "false" turns it off.
# VITE_ENABLE_DEV_GUIDE=false

# ── Optional integrations ────────────────────────────────────────────────────
# VITE_LOAD_TEST_BACKEND_URL=
# VITE_CHATBOT_MCP_BASE_URL=
# Note the spelling — the variable really is VITE_FRONTENT_URL in the source.
# VITE_FRONTENT_URL=

# ── Known wart ───────────────────────────────────────────────────────────────
# Attached as x-api-key on /api/sessions/flows calls by src/services/apiClient.ts.
# This ships automation-db's write-capable key to every browser that loads the
# app. The business dashboard deliberately does not use it — its own client goes
# through the backend's /dashboard proxy instead — but these flow calls still do.
# Routing them through the backend would let this variable be deleted.
VITE_DB_SERVICE_API_KEY=
